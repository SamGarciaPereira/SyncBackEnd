DATABASE_URL="mysql://usuario:senha@localhost:3306/nome_do_banco"
DATABASE_NAME="nome_do_banco"

# Segredo usado para assinar a sessão (login). Em produção, use um valor longo e aleatório.
SESSION_SECRET="troque-por-um-segredo-longo"
# Endereço do front (CORS com cookies)
CORS_ORIGIN="http://localhost:5173"

# --- Lembretes / Web Push ---
# Chaves VAPID. Gere com: npx web-push generate-vapid-keys
# A pública (VAPID_PUBLIC_KEY) é a mesma usada no front (VITE_VAPID_PUBLIC_KEY).
VAPID_PUBLIC_KEY="cole-a-chave-publica-aqui"
VAPID_PRIVATE_KEY="cole-a-chave-privada-aqui"
VAPID_SUBJECT="mailto:voce@exemplo.com"
# Segredo que o worker de lembretes usa para acionar o endpoint de disparo
CRON_SECRET="troque-por-um-segredo-aleatorio"
# URL pública da própria API (vai no payload do push, para o botão "Tomei")
PUBLIC_API_URL="http://localhost:3001/api"
# Fuso usado para casar os horários HH:mm dos lembretes
REMINDER_TZ="America/Sao_Paulo"
